# Chạy một job của Growth Workspace: %i là tên file trong src/jobs (không có .ts).
[Unit]
Description=Growth Workspace job %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=growth
Group=growth
WorkingDirectory=/opt/growth-workspace
EnvironmentFile=/etc/growth/growth.env
EnvironmentFile=/opt/growth-workspace/deploy/paths.env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/growth
ExecStart=/opt/bun/bin/bun run src/jobs/%i.ts
