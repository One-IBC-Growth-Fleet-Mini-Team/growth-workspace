# HTTPS cho Hàng chờ. setup.sh thay __QUEUE_DOMAIN__ và __ACME_EMAIL__ rồi chép vào /etc/caddy/Caddyfile.
# Caddy tự xin và gia hạn chứng chỉ (cổng 80 và 443 phải mở).
{
	email __ACME_EMAIL__
}

__QUEUE_DOMAIN__ {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}
