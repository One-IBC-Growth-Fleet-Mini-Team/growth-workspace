# Đường dẫn và tham số chạy cố định trên máy chủ (không có secret). systemd đọc file này SAU
# /etc/growth/growth.env nên các giá trị ở đây luôn thắng giá trị trống trong file secret.
GROWTH_DB_PATH=/srv/growth/data/growth.sqlite
SA01_EVAL_RESULTS_DIR=/srv/growth/data/eval-results
GROWTH_BACKUP_DIR=/srv/growth/data/backups
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
HOME=/srv/growth/home
