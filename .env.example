# Điền ở máy chạy, không commit file .env thật
CRM_API_BASE=
CRM_API_TOKEN=
IC_API_TOKEN=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
TEAMS_TENANT_ID=
# Đường dẫn file SQLite của Growth DB trên ổ bền (D-02)
GROWTH_DB_PATH=
# Khoá HMAC-SHA256 để băm email và SĐT của Lead (D-05), tối thiểu 32 ký tự
PII_HASH_KEY=
# Mã quốc gia mặc định khi chuẩn hoá SĐT dạng nội địa, chờ đối chiếu schema CRM (design doc mục 7.2)
PII_PHONE_DEFAULT_COUNTRY_CODE=
# Thư mục ca eval dựng từ dữ liệu thật, nằm ngoài repo (D-13)
SA01_PRIVATE_EVAL_DIR=
# Thư mục kết quả eval trên ổ bền khi chạy trong container (ví dụ /data/eval-results)
SA01_EVAL_RESULTS_DIR=
# Model LLM và bảng giá (USD cho 1 triệu token) để tính cost_usd
LLM_MODEL=
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
# Claude API cho Mi1-sa-01 (spec mục 10: dòng Sonnet, ví dụ LLM_MODEL=claude-sonnet-5-5)
ANTHROPIC_API_KEY=
# App Entra dùng chung cho đăng nhập Hàng chờ và đọc Graph (D-04, Q-02)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Channel "Đồng bộ dữ liệu" (chờ đối chiếu, design doc mục 5.3)
GRAPH_TEAM_ID=
GRAPH_CHANNEL_ID=
# Đăng nhập Hàng chờ (D-24): AUTH_MODE=password (mặc định, tạm) hoặc entra (D-04).
# Chế độ password: mã băm argon2 tạo bằng scripts/hash-password.ts.
AUTH_MODE=
AMY_PASSWORD_HASH=
MARK_PASSWORD_HASH=
# Nguồn tự báo (D-24): REPORT_SOURCE=paste (mặc định, Amy dán trên trang) hoặc graph (đọc Teams, cần quyền Q-02)
REPORT_SOURCE=
# Hàng chờ: khoá ký cookie phiên (tối thiểu 32 ký tự), địa chỉ https; AAD object id của Amy và Mark (chỉ chế độ entra)
SESSION_SECRET=
QUEUE_BASE_URL=
AMY_ENTRA_OID=
MARK_ENTRA_OID=
PORT=
# Webhook Teams (D-11, Q-11): thông báo hàng chờ cho Amy, tin escalate cho Mark
TEAMS_WEBHOOK_URL_AMY=
TEAMS_WEBHOOK_URL_MARK=
